# 复制为 .env 后填写。不要提交 .env。
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-this-stable-salt
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://litellm:change-this-database-password@database:5432/litellm

DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=replace-with-your-provider-key
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_API_KEY=replace-with-your-provider-key

# 默认仅本机可访问。通过内网 HTTPS 反向代理共享时保持此值。
GATEWAY_BIND=127.0.0.1
